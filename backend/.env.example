# Neon pooled connection string. Keep this server-side only.
# Replace every placeholder locally. Never commit credentials or deployment-specific values.
APP_BASE_URL=http://localhost:5173
AUTH0_AUDIENCE=https://api.novacare.example
AUTH0_DOMAIN=your-tenant.us.auth0.com
BREVO_API_KEY=your-brevo-api-key
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
EMAIL_FROM=NovaCare <noreply@example.com>
GEMINI_API_KEY=your-gemini-api-key
NODE_ENV=development
GEMINI_MODEL=gemini-3.8-flash
# Africa's Talking USSD sandbox credentials. Server-side only; never expose to the frontend.
AT_USERNAME=sandbox
AT_API_KEY=
AT_USSD_SERVICE_CODE=
AT_TEST_PHONE=

# Dispatch radius controls for the simulated development network.
DISPATCH_INITIAL_RADIUS_KM=5
DISPATCH_RADIUS_INCREMENT_KM=5
DISPATCH_MIN_FACILITIES=3
DISPATCH_MAX_RADIUS_KM=50
